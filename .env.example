# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit the filled-in file.
# In production these are set in the Vercel project settings.
# ---------------------------------------------------------------------------

# Public base URL, used for canonical links, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Neon / Vercel Postgres) -------------------------------------
# Pooled connection string. Used by the app at runtime AND by the Prisma CLI.
# Neon: copy the "Pooled connection" string and keep ?sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional: separate shadow database, only needed for `prisma migrate dev`.
# Not required if you use `npm run db:push`.
SHADOW_DATABASE_URL=""

# --- Auth (NextAuth credentials, single owner account) ---------------------
# Required — NextAuth reads this itself. Sign-in fails without it.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Owner login. The password is stored as a bcrypt hash in the database,
# seeded by `npm run db:seed` — these two drive that seed.
OWNER_EMAIL=""
OWNER_PASSWORD=""

# --- Google Gemini ---------------------------------------------------------
# Server-side only. Must never be exposed to the browser.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --- Telegram (mobile message -> task) -------------------------------------
TELEGRAM_BOT_TOKEN=""
# Secret token Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=""
# Only this Telegram numeric user id may create or modify tasks.
TELEGRAM_ALLOWED_USER_ID=""

# --- Misc ------------------------------------------------------------------
# Salt for hashing submitter IPs before storage.
IP_HASH_SALT=""
